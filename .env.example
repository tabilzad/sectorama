# Server
PORT=8888
NODE_ENV=development

# SQLite — embedded database for drive registry, schedules, and run metadata
SQLITE_PATH=./sectorama.db

# InfluxDB v2 — time-series storage for SMART history and benchmark speed points
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=dev-token-local
INFLUXDB_ORG=sectorama
INFLUXDB_BUCKET=sectorama
INFLUXDB_ADMIN_PASSWORD=adminpass
# Data retention for the InfluxDB bucket in seconds (default: 180 days = 15552000).
# Use 0 for infinite retention.
# NOTE: Only applied on first-time bucket creation. To update an existing bucket's
# retention use: docker exec sectorama-influxdb influx bucket update \
#   --name sectorama --org sectorama --retention 15552000s --token <token>
INFLUXDB_RETENTION_SECONDS=15552000

# ─── Runtime settings ──────────────────────────────────────────────────────────
# The four values below are managed from the Settings page and stored in SQLite.
# Set one here only to pin it: a non-blank value wins over the UI and the field
# is shown read-only there. Leave them unset (or blank) to keep them editable.

# SMART polling interval in minutes (UI default: 5). Values <60 must divide
# evenly into 60 (e.g. 5, 10, 15, 30); values >=60 are treated as whole hours.
#SMART_POLL_INTERVAL_MINUTES=5

# How many drives are polled for SMART data at the same time (UI default: 4).
#SMART_POLL_CONCURRENCY=4

# Default number of evenly-spaced positions measured per benchmark run (UI default: 11).
#BENCHMARK_NUM_POINTS=11

# Default temperature alert threshold in °C for drives without their own setting
# (UI default: 50). Alerts fire when a drive's temperature transitions from
# at-or-below this value to above it.
#TEMPERATURE_ALERT_THRESHOLD_CELSIUS=50

# Set to true on Windows/macOS where smartctl and fio cannot access raw block devices.
# Returns synthetic drives and mock SMART/benchmark data for UI development.
DISK_DISCOVERY_MOCK=false

# VAPID subject — identifies this server to browser push services.
# Must be a mailto: or https: URI. Do NOT use localhost — Apple's push service
# (web.push.apple.com) rejects localhost subjects with 403 BadJwtToken.
# Use your real domain or email address for iOS push to work.
VAPID_SUBJECT=mailto:push@yourdomain.com

# Filesystem usage for the dashboard's storage overview. The container can only
# measure filesystems it can see, so bind-mount the host paths you care about:
#   - /mnt:/mnt:ro                              (generic Linux; all mounts under STORAGE_MOUNT_ROOT are measured)
#   - /var/local/emhttp:/var/local/emhttp:ro    (Unraid; per-disk usage is read from disks.ini instead)
STORAGE_MOUNT_ROOT=/mnt
UNRAID_EMHTTP_DIR=/var/local/emhttp
